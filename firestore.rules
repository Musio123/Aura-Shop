rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Products catalog: publicly readable so shoppers can browse
    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Orders: shoppers can create orders, and read their own orders
    match /orders/{orderId} {
      allow create: if true; // allow guest & signed-in checkout
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || (!isSignedIn() && resource.data.userId == 'guest');
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid);
    }

    // User profiles: strictly accessible by the account owner
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
