{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store item available for purchase",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 2000 },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "category": { "type": "string", "maxLength": 50 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "images": { "type": "array" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "stock": { "type": "number" },
        "featured": { "type": "boolean" },
        "tags": { "type": "array" }
      },
      "required": ["id", "name", "price", "category", "imageUrl"]
    },
    "Order": {
      "title": "Order",
      "description": "Completed customer order containing items and shipping info",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "maxLength": 128 },
        "customerEmail": { "type": "string", "maxLength": 255 },
        "customerName": { "type": "string", "maxLength": 150 },
        "shippingAddress": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shippingFee": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 50 },
        "emailStatus": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerEmail", "customerName", "items", "total", "status", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Customer preferences and saved address profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 255 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "savedAddress": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Store products catalog"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with saved preferences"
    }
  }
}
